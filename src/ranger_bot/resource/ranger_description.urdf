<?xml version="1.0"?>
<!-- Full TurtleBot3 Burger URDF as generated by the Webots driver from nature_reserve.wbt
     (captured 2026-10-31 from /robot_state_publisher after the driver pushed it), plus the
     <ros2_control> block from ranger_webots.urdf.

     robot_state_publisher loads this file directly. Relying on the driver's
     set_robot_state_publisher push was racy: when many nodes start at once (Nav2), the
     driver's parameter call silently missed robot_state_publisher, leaving no LDS-01 frame.
     The driver's controller_manager also reads /robot_description, so <ros2_control> must stay.

     Regenerate if the robot in the world changes (devices added/moved): launch with
     set_robot_state_publisher true and dump `ros2 param get /robot_state_publisher robot_description`. -->
<robot name="TurtleBot3Burger" xmlns:xacro="http://ros.org/wiki/xacro">
    <link name="base_link">
        <visual>
            <origin xyz="-0.032 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="0.097 0.137 0.1425"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.032 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="0.097 0.137 0.1425"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.032 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="0.135 0.095 0.143"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.032 0 0.08" rpy="0 0 0"/>
            <geometry>
                <box size="0.135 0.095 0.143"/>
            </geometry>
        </collision>
    </link>
    <link name="compass"/>
    <joint name="base_link_compass_joint" type="fixed">
        <parent link="base_link"/>
        <child link="compass"/>
        <origin xyz="-0.032 0 0.078" rpy="0 0 0"/>
    </joint>
    <link name="gyro"/>
    <joint name="base_link_gyro_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gyro"/>
        <origin xyz="-0.032 0 0.078" rpy="0 0 0"/>
    </joint>
    <link name="accelerometer"/>
    <joint name="base_link_accelerometer_joint" type="fixed">
        <parent link="base_link"/>
        <child link="accelerometer"/>
        <origin xyz="-0.032 0 0.078" rpy="0 0 0"/>
    </joint>
    <joint name="left wheel motor" type="continuous">
        <parent link="base_link"/>
        <child link="left wheel"/>
        <axis xyz="-0.000003 -1 0.000003"/>
        <limit effort="10" velocity="6.67"/>
        <origin xyz="0 0.08 0.033" rpy="-0.526852 -1.57079 -2.614737"/>
    </joint>
    <link name="left wheel">
        <visual>
            <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.018"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.018"/>
            </geometry>
        </collision>
    </link>
    <joint name="right wheel motor" type="continuous">
        <parent link="base_link"/>
        <child link="right wheel"/>
        <axis xyz="0 1 0"/>
        <limit effort="10" velocity="6.67"/>
        <origin xyz="0 -0.08 0.033" rpy="0 -1.570796 0"/>
    </joint>
    <link name="right wheel">
        <visual>
            <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.018"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.018"/>
            </geometry>
        </collision>
    </link>
    <link name="camera"/>
    <joint name="base_link_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera"/>
        <origin xyz="0 0 0.363" rpy="-1.570796 0 -1.570796"/>
    </joint>
    <link name="LDS-01">
        <visual>
            <origin xyz="0.014 0 -0.014" rpy="1.5708 0.00001 -1.5708"/>
            <geometry>
                <box size="0.07 0.01 0.1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.014 0 -0.014" rpy="1.5708 0.00001 -1.5708"/>
            <geometry>
                <box size="0.07 0.01 0.1"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.021"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.032" length="0.021"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_link_LDS-01_joint" type="fixed">
        <parent link="base_link"/>
        <child link="LDS-01"/>
        <origin xyz="-0.03 0 0.173" rpy="0 0 0"/>
    </joint>
    <link name="screw3">
        <visual>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </collision>
    </link>
    <joint name="LDS-01_screw3_joint" type="fixed">
        <parent link="LDS-01"/>
        <child link="screw3"/>
        <origin xyz="0.035 0.0245 -0.0105" rpy="0 1.570787 0"/>
    </joint>
    <link name="screw2">
        <visual>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </collision>
    </link>
    <joint name="LDS-01_screw2_joint" type="fixed">
        <parent link="LDS-01"/>
        <child link="screw2"/>
        <origin xyz="0.035 0.0245 -0.0105" rpy="0 1.570787 0"/>
    </joint>
    <link name="screw1">
        <visual>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </collision>
    </link>
    <joint name="LDS-01_screw1_joint" type="fixed">
        <parent link="LDS-01"/>
        <child link="screw1"/>
        <origin xyz="0.035 0.0245 -0.0105" rpy="0 1.570787 0"/>
    </joint>
    <link name="screw0">
        <visual>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.01 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0015" length="0.02"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.0015 0 0" rpy="3.141593 1.570793 3.141593"/>
            <geometry>
                <cylinder radius="0.0025" length="0.003"/>
            </geometry>
        </collision>
    </link>
    <joint name="LDS-01_screw0_joint" type="fixed">
        <parent link="LDS-01"/>
        <child link="screw0"/>
        <origin xyz="0.035 0.0245 -0.0105" rpy="0 1.570787 0"/>
    </joint>
    <joint name="LDS-01_secondary_motor" type="continuous">
        <parent link="LDS-01"/>
        <child link="solid"/>
        <axis xyz="0 -0.000004 1"/>
        <limit effort="10" velocity="150"/>
        <origin xyz="-0.046 0.01 -0.01" rpy="-0.000014 0.000005 3.141587"/>
    </joint>
    <link name="solid"/>
    <joint name="LDS-01_main_motor" type="continuous">
        <parent link="LDS-01"/>
        <child link="lower"/>
        <axis xyz="0 -0.000004 1"/>
        <limit effort="10" velocity="40"/>
        <origin xyz="-0.046 0.02 -0.01" rpy="-0.000014 0.000005 3.141587"/>
    </joint>
    <link name="lower"/>
    <link name="inertial_unit"/>
    <joint name="base_link_inertial_unit_joint" type="fixed">
        <parent link="base_link"/>
        <child link="inertial_unit"/>
        <origin xyz="-0.03 0.01 0.153" rpy="0 0 0"/>
    </joint>
    <link name="gps"/>
    <joint name="base_link_gps_joint" type="fixed">
        <parent link="base_link"/>
        <child link="gps"/>
        <origin xyz="-0.03 0 0.153" rpy="0 0 0"/>
    </joint>
    <link name="imu_link"/>
    <joint name="base_link_imu_link_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="-0.03 0 0.153" rpy="0 0 0"/>
    </joint>
    <webots>
        <device reference="LDS-01" type="Lidar">
            <ros>
                <enabled>true</enabled>
                <updateRate>5</updateRate>
                <topicName>/scan</topicName>
                <alwaysOn>false</alwaysOn>
                <frameName>LDS-01</frameName>
            </ros>
        </device>
        <device reference="camera" type="Camera">
            <ros>
                <enabled>true</enabled>
                <updateRate>10</updateRate>
                <topicName>/camera</topicName>
                <alwaysOn>false</alwaysOn>
                <frameName>camera</frameName>
            </ros>
        </device>
        <!-- Ground-truth position from the simulator, for checking odometry/SLAM. -->
        <device reference="gps" type="GPS">
            <ros>
                <enabled>true</enabled>
                <updateRate>10</updateRate>
                <topicName>/gps</topicName>
                <alwaysOn>true</alwaysOn>
                <frameName>gps</frameName>
            </ros>
        </device>
        <plugin type="webots_ros2_driver::Ros2IMU">
            <enabled>true</enabled>
            <updateRate>20</updateRate>
            <topicName>/imu</topicName>
            <alwaysOn>false</alwaysOn>
            <frameName>imu_link</frameName>
            <inertialUnitName>inertial_unit</inertialUnitName>
            <gyroName>gyro</gyroName>
            <accelerometerName>accelerometer</accelerometerName>
        </plugin>
        <plugin type="webots_ros2_control::Ros2Control"/>
    </webots>
    <ros2_control name="WebotsControl" type="system">
        <hardware>
            <plugin>webots_ros2_control::Ros2ControlSystem</plugin>
        </hardware>
        <joint name="right wheel motor">
            <state_interface name="position"/>
            <command_interface name="velocity"/>
        </joint>
        <joint name="left wheel motor">
            <state_interface name="position"/>
            <command_interface name="velocity"/>
        </joint>
    </ros2_control>
</robot>

